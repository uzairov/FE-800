// TalentLens — Prisma Schema
// Based on Data Model §8.2 of the TZ v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  HR
  VIEWER
}

enum AssessmentStatus {
  CREATED       // link generated, not yet opened
  LINK_OPENED   // candidate opened the link
  IN_PROGRESS   // candidate started the test
  COMPLETED     // candidate finished
}

enum FlagLevel {
  INFO     // grey  — minor deviation
  WARNING  // orange — pay attention
  CRITICAL // red   — likely dishonest
}

// ─────────────────────────────────────────────
// COMPANY
// ─────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")   // free | basic | pro
  logo      String?                      // URL or S3 key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  assessments Assessment[]
}

// ─────────────────────────────────────────────
// USER (HR)
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String                        // bcrypt hash
  name      String?
  role      Role     @default(HR)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments   Assessment[]
  refreshTokens RefreshToken[]

  @@index([companyId])
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// ASSESSMENT
// ─────────────────────────────────────────────

model Assessment {
  id              String           @id @default(cuid())
  candidateName   String
  positionId      String
  status          AssessmentStatus @default(CREATED)
  linkUuid        String           @unique @default(uuid()) // UUID v4 for candidate URL
  linkExpiresAt   DateTime                                  // +7 days from creation
  competencies    Json                                      // string[] — selected competency keys
  estimatedMinutes Int             @default(0)             // estimated test duration

  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  testSession     TestSession?
  riskFlags       RiskFlag[]

  @@index([companyId])
  @@index([createdById])
  @@index([linkUuid])
  @@index([status])
}

// ─────────────────────────────────────────────
// TEST SESSION (candidate side)
// ─────────────────────────────────────────────

model TestSession {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  language     String     @default("ru")  // ru | uz | en
  startedAt    DateTime?
  finishedAt   DateTime?
  tabSwitches  Int        @default(0)
  answersJson  Json       @default("[]")
  // answersJson schema: Array<{
  //   questionId: string,
  //   selectedOption: number,  // 0-based index
  //   answeredAt: string,      // ISO timestamp
  //   responseMs: number       // milliseconds spent on this question
  // }>

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─────────────────────────────────────────────
// QUESTION
// ─────────────────────────────────────────────

model Question {
  id          String   @id @default(cuid())
  blockType   String   // e.g. "SJT_SALES", "PSS", "BIG_FIVE", etc.
  textRu      String   @db.Text
  textUz      String   @db.Text
  textEn      String   @db.Text
  optionsJson Json
  // optionsJson schema: Array<{
  //   textRu: string, textUz: string, textEn: string
  // }>
  scoringJson Json
  // scoringJson schema: Array<{
  //   competency: string,  // e.g. "stress_resistance"
  //   scores: number[]     // score per option index (1–4)
  // }>
  orderIndex  Int      @default(0)  // default display order (randomised at runtime)
  createdAt   DateTime @default(now())

  @@index([blockType])
}

// ─────────────────────────────────────────────
// POSITION TEMPLATE
// ─────────────────────────────────────────────

model PositionTemplate {
  id               String   @id @default(cuid())
  name             String
  nameUz           String   @default("")
  nameEn           String   @default("")
  industry         String
  level            String   // linear | specialist | manager | top
  isActive         Boolean  @default(true)
  competenciesJson Json
  // competenciesJson schema: Array<{
  //   key: string,          // e.g. "stress_resistance"
  //   weight: 1 | 2 | 3    // optional(1) | important(2) | required(3)  — §7.2
  // }>
  blocksJson       Json
  // blocksJson schema: string[]  — blockType keys in order
  estimatedMinutes Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─────────────────────────────────────────────
// RISK FLAG  (antifrod §6)
// ─────────────────────────────────────────────

model RiskFlag {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  level        FlagLevel
  type         String     // "fast_answers" | "tab_switches" | "inconsistency" | "answer_pattern"
  descriptionRu String
  value        Float?     // numeric value that triggered the flag (e.g. % fast answers)
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// COMPETENCY RESULT  (calculated on finish)
// ─────────────────────────────────────────────

model CompetencyResult {
  id           String   @id @default(cuid())
  assessmentId String
  competency   String   // e.g. "stress_resistance"
  score        Float    // 0–100 %
  level        String   // "high" | "medium" | "low"
  weight       Int      @default(1) // weight from position template
  createdAt    DateTime @default(now())

  @@unique([assessmentId, competency])
  @@index([assessmentId])
}
