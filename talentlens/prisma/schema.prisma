// TalentLens — Prisma Schema v2
// Relations added, CompetencyResult linked to Assessment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  HR
  VIEWER
}

enum AssessmentStatus {
  CREATED       // link generated, not yet opened
  LINK_OPENED   // candidate opened the link
  IN_PROGRESS   // candidate started the test
  COMPLETED     // candidate finished
}

enum FlagLevel {
  INFO     // grey  — minor deviation
  WARNING  // orange — pay attention
  CRITICAL // red   — likely dishonest
}

// ─────────────────────────────────────────────
// COMPANY
// ─────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  assessments    Assessment[]
  teamInvites    TeamInvite[]
  webhookSetting WebhookSetting?
}

// ─────────────────────────────────────────────
// USER (HR)
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(HR)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments     Assessment[]
  refreshTokens   RefreshToken[]
  reportComments  ReportComment[]
  sentInvites     TeamInvite[]

  @@index([companyId])
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// POSITION TEMPLATE
// ─────────────────────────────────────────────

model PositionTemplate {
  id               String   @id @default(cuid())
  name             String
  nameUz           String   @default("")
  nameEn           String   @default("")
  industry         String
  level            String   // linear | specialist | manager | top
  isActive         Boolean  @default(true)
  competenciesJson Json
  // Array<{ key: string; weight: 1|2|3 }>
  blocksJson       Json
  // string[] — ordered block type keys
  estimatedMinutes Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assessments      Assessment[]
}

// ─────────────────────────────────────────────
// ASSESSMENT
// ─────────────────────────────────────────────

model Assessment {
  id               String           @id @default(cuid())
  candidateName    String
  positionId       String
  position         PositionTemplate @relation(fields: [positionId], references: [id])
  status           AssessmentStatus @default(CREATED)
  linkUuid         String           @unique @default(uuid())
  linkExpiresAt    DateTime
  competencies     Json             // string[] — selected competency keys
  estimatedMinutes Int              @default(0)

  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id])

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  testSession       TestSession?
  riskFlags         RiskFlag[]
  competencyResults CompetencyResult[]
  reportComments    ReportComment[]

  @@index([companyId])
  @@index([createdById])
  @@index([linkUuid])
  @@index([status])
  @@index([positionId])
}

// ─────────────────────────────────────────────
// TEST SESSION
// ─────────────────────────────────────────────

model TestSession {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  language     String     @default("ru")
  startedAt    DateTime?
  finishedAt   DateTime?
  tabSwitches  Int        @default(0)
  answersJson  Json       @default("[]")
  // Array<{ questionId: string; selectedOption: number; answeredAt: string; responseMs: number }>

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─────────────────────────────────────────────
// QUESTION
// ─────────────────────────────────────────────

model Question {
  id          String   @id @default(cuid())
  blockType   String
  textRu      String   @db.Text
  textUz      String   @db.Text
  textEn      String   @db.Text
  optionsJson Json
  // Array<{ textRu: string; textUz: string; textEn: string }>
  scoringJson Json
  // Array<{ competency: string; scores: number[] }>  — scores[optionIndex] = 1..4
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([blockType])
}

// ─────────────────────────────────────────────
// RISK FLAG  (antifrod §6)
// ─────────────────────────────────────────────

model RiskFlag {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  level         FlagLevel
  type          String     // fast_answers | tab_switches | inconsistency | answer_pattern
  descriptionRu String
  value         Float?
  createdAt     DateTime   @default(now())

  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// COMPETENCY RESULT  (calculated on finish §7)
// ─────────────────────────────────────────────

model CompetencyResult {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competency   String
  score        Float      // 0–100 %
  level        String     // high | medium | low
  weight       Int        @default(1)
  createdAt    DateTime   @default(now())

  comments     ReportComment[]

  @@unique([assessmentId, competency])
  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// REPORT COMMENT  (HR annotations on report)
// ─────────────────────────────────────────────

model ReportComment {
  id                 String           @id @default(cuid())
  assessmentId       String
  assessment         Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyResultId String?
  competencyResult   CompetencyResult? @relation(fields: [competencyResultId], references: [id], onDelete: SetNull)
  authorId           String
  author             User             @relation(fields: [authorId], references: [id])
  text               String           @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// TEAM INVITE
// ─────────────────────────────────────────────

model TeamInvite {
  id          String   @id @default(cuid())
  email       String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User     @relation(fields: [invitedById], references: [id])
  role        Role     @default(HR)
  token       String   @unique @default(uuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([token])
}

// ─────────────────────────────────────────────
// WEBHOOK SETTING
// ─────────────────────────────────────────────

model WebhookSetting {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  telegramBotToken String?
  telegramChatId   String?
  slackWebhookUrl  String?
  onCompleted      Boolean @default(true)
  onCreated        Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
